const express=require("express")
const cors=require("cors")
const mysql=require("mysql2")
const app=express()
app.use(cors())
app.use(express.json())
const db=mysql.createConnection(
    {
host:"localhost",
user:"root",
password:"pika1471",
database:"practiceendmodule"
})
app.get("/",()=>{
    console.log("backend is working")
})
app.post("/add",(req,res)=>{
    const {empId,empName,joiningDate,designation} =req.body
    db.query("insert into employe(empId,empName,joiningDate,designation) values(?,?,?,?)",[empId,empName,joiningDate,designation],(err,result)=>{
        if(err){
            return res.status(500).json({message:"data not inserted",error: err});
        }
        else{
            return res.json({message:"Data inserted"})
        }
    })
})
app.get("/get",(req,res)=>{
    db.query("select * from employe",(err,result)=>{
        if(err){
            return res.status(404).json({message:"data not get",error: err});
        }
        else{
            return res.json({data:result})
        }
    })
})
app.delete("/delete/:empId",(req,res)=>{
    db.query("delete from employe where empId=?",[req.params.empId],(err,result)=>{
        if(err){
            return res.status(404).json({message:"data not get",error: err});
        }
        else{
            return res.json({message:"deleted successfully"})
        }
    })
})

app.listen(8080,()=>{
    console.log("Backend is working")
})
